{
  "name": "@pondlog/worker-remote",
  "version": "0.1.0",
  "private": true,
  "description": "Fork-only: pondlog's MCP servers as one Cloudflare Worker behind a Code Mode `code` tool, signed in with GitHub, one eBird key per user.",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "e2e": "wrangler deploy --dry-run --outdir dist && node scripts/e2e.mjs"
  },
  "dependencies": {
    "@cloudflare/codemode": "0.5.6",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@pondlog/mcp-ebird": "workspace:^",
    "@pondlog/mcp-mushroomobserver": "workspace:^",
    "@pondlog/mcp-npn": "workspace:^",
    "@pondlog/mcp-pondlog": "workspace:^",
    "@pondlog/mcp-usgs": "workspace:^",
    "@pondlog/source-ebird": "workspace:^",
    "agents": "0.33.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "wrangler": "4.165.0",
    "miniflare": "5.20261118.0-beta",
    "vitest": "^2.1.8"
  }
}
