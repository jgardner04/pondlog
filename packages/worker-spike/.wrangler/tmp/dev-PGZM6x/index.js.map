      "climateModifiers": {
        "mediterranean": {
          "notes": "Sets fruit reliably in long Mediterranean summers; the defining paste tomato. Train indeterminate vines on stakes; pinch suckers for cleaner harvest."
        },
        "humid_subtropical": {
          "windowShifts": {
            "transplant": -1
          },
          "notes": "Susceptible to blossom-end rot in wet Florida summers; mulch heavily and maintain steady moisture. Choose the disease-resistant San Marzano 2 strain."
        },
        "maritime": {
          "windowShifts": {
            "start_indoors": -1,
            "transplant": 2
          },
          "notes": "Marginal in cool maritime; chooses long warm summers. Late blight pressure heavy; stake vines and prune lower foliage for airflow."
        },
        "continental": {
          "notes": "Direct sun and 8 weeks indoor start produce ripe paste tomatoes by mid-August. Single stem with stake gives the cleanest fruit set."
        },
        "arid": {
          "notes": "Productive in arid heat with consistent drip irrigation; 30% shade cloth above 95F prevents blossom-end rot. Sun-dried tomato cultivar of choice."
        }
      }
