    {
      "crop": "radish",
      "companion": "cucumber",
      "type": "beneficial",
      "mechanism": "trap_crop",
      "description": "Radishes planted among cucumber vines attract cucumber beetles and flea beetles; let some bolt to flower and continue trapping. Sacrificial radishes can be removed and replanted as needed.",
      "strength": "moderate",
      "source": "Cornell Cooperative Extension; Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "onion",
      "companion": "carrot",
      "type": "beneficial",
      "mechanism": "pest_repellent",
      "description": "Onion's volatile sulfur compounds confuse and deter carrot rust fly (Psila rosae), one of the worst carrot pests in temperate gardens. Interplant in alternating rows. The classic mutual European-tradition pairing.",
      "strength": "strong",
      "source": "Cornell Cooperative Extension; Riotte, Carrots Love Tomatoes"
