{
  "version": "1",
  "source": "Cornell Cooperative Extension; UC IPM Online (University of California Statewide Integrated Pest Management Program); UF/IFAS Extension; Penn State Extension; OSU Extension; WSU Extension; Texas A&M AgriLife Extension; Rodale Encyclopedia of Organic Gardening; USDA-ARS pest profiles. Organic management options are restricted to OMRI-listed materials and physical/cultural controls; conventional synthetic pesticide options are intentionally omitted (this is an organic-gardener-facing fixture). Severity grades are honest: `severe` is reserved for crop-killing pests/diseases that warrant scouting twice weekly; `high` is significant yield loss; `moderate` is cosmetic or partial yield; `low` is tolerable in most beds. Symptoms strings are diagnostic, not encyclopedic, written for a gardener with a hand lens.",
  "license": "CC-BY-4.0",
  "lastUpdated": "2026-05-13",
  "entries": [
    {
      "crop": "tomato",
      "pest": "tomato-hornworm",
      "type": "pest",
      "severity": "high",
      "symptoms": "Large green caterpillars (3-4 inches at maturity) with white diagonal stripes and a curved horn at the rear. Defoliation of upper leaves first, working down the plant. Dark green droppings on lower leaves are usually the first sign before the caterpillar itself is spotted.",
      "organicManagement": [
        "Handpick into soapy water; the most effective control for small gardens.",
        "Spray Bt (Bacillus thuringiensis var. kurstaki) on foliage; works on larvae under 1.5 inches.",
        "Encourage parasitic braconid wasps (white rice-like cocoons on hornworm backs); leave parasitized hornworms in place to release the next wasp generation.",
        "Companion plant with dill, basil, marigold to draw braconid wasps."
      ],
      "prevention": "Fall tilling exposes overwintering pupae to predators and freezing. Rotate nightshades on a 3-year cycle. Inspect plants twice weekly from July through August.",
      "regions": ["all"],
      "source": "Cornell Cooperative Extension; UC IPM"
    },
    {
      "crop": "tomato",
      "pest": "tomato-fruitworm",
      "type": "pest",
      "severity": "high",
      "symptoms": "Small holes near the stem end of fruit. Inside, a 1-1.5 inch striped caterpillar (yellow-green to pink-brown) eating from the inside out. Same species as corn earworm.",
      "organicManagement": [
        "Spray Bt on developing fruit weekly during egg-laying flights.",
        "Release Trichogramma wasps (egg parasitoid) when adult moths are first trapped.",
        "Remove and destroy infested fruit; do not compost."
      ],
      "prevention": "Pheromone traps to monitor adult flights. Plant trap crops of corn or sunflower at the bed edge to draw egg-laying moths away from tomatoes.",
      "regions": ["all"],
      "source": "UC IPM; Penn State Extension"
    },
    {
      "crop": "tomato",
      "pest": "early-blight",
      "type": "disease",
      "severity": "high",
      "symptoms": "Dark brown concentric-ring spots on lower leaves first, expanding upward. Yellow halo around each lesion. Stem cankers at the soil line. Defoliated lower stems with green upper canopy is the classic pattern.",
      "organicManagement": [
        "Copper-based fungicide (OMRI-listed) weekly once symptoms appear.",
        "Remove and destroy infected leaves; do not compost.",
        "Mulch heavily to block soil splash that spreads Alternaria spores."
      ],
      "prevention": "Stake or cage plants for airflow. Drip irrigation, not overhead. Three-year rotation away from all nightshades. Resistant varieties (Mountain Magic, Iron Lady).",
      "regions": ["all"],
      "source": "Cornell Cooperative Extension; UC IPM"
    },
    {
      "crop": "tomato",
      "pest": "late-blight",
      "type": "disease",
      "severity": "severe",
      "symptoms": "Water-soaked dark green to brown blotches on leaves with pale-green halos. White downy growth on leaf undersides in humid conditions. Fruit develop dark greasy-looking patches. Whole plants collapse within days in cool wet weather.",
      "organicManagement": [
        "Copper-based fungicide (OMRI-listed) as a preventive when forecast turns cool and wet; rarely effective once symptoms appear.",
        "Remove and bag infected plants immediately; do not compost.",
        "Sanitize stakes, cages, and tools."
      ],
      "prevention": "Plant resistant varieties (Mountain Magic, Defiant, Iron Lady). Avoid overhead watering. Provide airflow. Destroy volunteer tomato and potato plants. Buy certified disease-free seed potatoes.",
      "regions": ["all"],
      "source": "Cornell Cooperative Extension; USDA-APHIS late blight monitoring"
    },
    {
      "crop": "tomato",
      "pest": "septoria-leaf-spot",
      "type": "disease",
      "severity": "moderate",
      "symptoms": "Small circular spots (1/8 inch) with dark borders and gray-tan centers on lower leaves, with tiny black fruiting bodies visible in the center under a hand lens. Leaves yellow and drop from the bottom up.",
      "organicManagement": [
        "Copper or Bacillus subtilis (Serenade) sprays at first symptom.",
        "Remove and destroy infected leaves at the first spot.",
        "Mulch to block spore-laden soil splash."
      ],
      "prevention": "Three-year rotation. Stake for airflow. Drip irrigation. Sanitize stakes and tools between seasons.",
      "regions": ["all"],
      "source": "Cornell Cooperative Extension; UC IPM"
    },
    {
      "crop": "tomato",
      "pest": "blossom-end-rot",
      "type": "disease",
      "severity": "moderate",
      "symptoms": "Dark brown to black sunken leathery patch on the blossom end of fruit. Not a pathogen, a calcium uptake disorder. First-set fruit are the most susceptible; later fruit often clean up on the same plant.",
      "organicManagement": [
        "Remove affected fruit, the plant cannot recover individual fruit but later set is usually clean.",
        "Mulch heavily and water deeply 1-2 times per week to keep soil moisture even."
      ],
      "prevention": "Avoid drought stress at fruit-set; calcium uptake fails under fluctuating soil moisture, not under low soil calcium in most beds. Mulch. Avoid high-nitrogen fertilizer at fruit-set.",
      "regions": ["all"],
      "source": "UC IPM; Cornell Cooperative Extension"
    },
    {
      "crop": "tomato",
      "pest": "fusarium-wilt",
      "type": "disease",
      "severity": "severe",
      "symptoms": "One-sided yellowing then wilting, often starting on one branch and progressing up. Brown vascular discoloration when stem is cut. Plant typically dies within 2-3 weeks once wilt is visible.",
      "organicManagement": [
        "No organic cure; remove and destroy infected plants.",
        "Solarize the bed with clear plastic for 6-8 weeks of midsummer sun."
      ],
      "prevention": "Plant resistant varieties (look for F, FF, or FFF designation). Five-year rotation away from all nightshades. Avoid working beds when soil is wet.",
      "regions": ["all"],
      "source": "Cornell Cooperative Extension; UC IPM"
    },
    {
      "crop": "tomato",
      "pest": "verticillium-wilt",
      "type": "disease",
      "severity": "severe",
      "symptoms": "V-shaped yellow patches on lower leaves spreading upward. Brown vascular discoloration in stems and roots. Wilting in midday heat with partial recovery overnight. Plants survive but produce reduced fruit.",
      "organicManagement": [
        "No organic cure; remove infected plants.",
        "Solarize the bed for 6-8 weeks in midsummer."
      ],
      "prevention": "Plant resistant varieties (V designation). Long rotation away from nightshades, strawberries, and stone fruit. Verticillium has a wide host range, so a 5-year break is conservative.",
      "regions": ["all"],
      "source": "WSU Extension; UC IPM"
    },
    {
      "crop": "tomato",
      "pest": "aphid-green-peach",
      "type": "pest",
      "severity": "moderate",
      "symptoms": "Soft-bodied green insects clustered on new growth and leaf undersides. Sticky honeydew on leaves below. Curled, distorted new leaves. Sooty mold on honeydew deposits.",
      "organicManagement": [
        "Strong water spray dislodges most aphids; repeat every 2-3 days.",
        "Insecticidal soap or neem oil on heavy infestations.",
        "Release lady beetles, lacewings, or syrphid fly larvae."
      ],
      "prevention": "Avoid high-nitrogen fertilization that pushes soft new growth. Encourage beneficials by planting umbellifer flowers (dill, fennel, cilantro left to flower) at the bed edge.",
      "regions": ["all"],
      "source": "UC IPM; Xerces Society"
    },
    {
      "crop": "tomato",
      "pest": "whitefly",
      "type": "pest",
      "severity": "moderate",
      "symptoms": "Tiny white moth-like insects flutter up when foliage is disturbed. Yellow stippling on leaf upper surface. Sticky honeydew and sooty mold below. Pupae are flat oval scales on leaf undersides.",
      "organicManagement": [
        "Yellow sticky traps placed at canopy height.",
        "Insecticidal soap or neem oil, focused on leaf undersides, every 5-7 days.",
        "Release Encarsia formosa (parasitoid wasp) in greenhouse settings."
      ],
      "prevention": "Inspect transplants before bringing into the garden. Reflective silver mulch deters adults from landing.",
      "regions": ["all"],
      "source": "UF/IFAS Extension; UC IPM"
    },
    {
      "crop": "pepper-sweet",
      "pest": "pepper-maggot",
      "type": "pest",
      "severity": "high",
      "symptoms": "Small white maggots inside fruit. External dimples or oviposition scars on fruit skin. Premature color change and rot. Adults are small flies with patterned wings.",
      "organicManagement": [
        "Remove and destroy infested fruit; do not compost.",
        "Yellow sticky traps to monitor adult emergence.",
        "Spinosad applied at first adult-flight detection."
      ],
      "prevention": "Three-year rotation. Cull cherry-pepper hosts at field edges. Heavy mulch traps emerging adults.",
      "regions": ["northeast-us", "midwest-us"],
      "source": "Cornell Cooperative Extension; Penn State Extension"
    },
    {
      "crop": "pepper-sweet",
      "pest": "aphid-green-peach",
      "type": "pest",
      "severity": "moderate",
      "symptoms": "Curled new growth, sticky honeydew, sooty mold. Peppers tolerate moderate aphid pressure but heavy infestations vector potato virus Y and tobacco etch virus.",
      "organicManagement": [
        "Water spray, insecticidal soap, neem oil.",
        "Release lady beetles or lacewings."
      ],
      "prevention": "Reflective mulch deters winged aphids. Companion umbellifers attract aphid predators.",
      "regions": ["all"],
      "source": "UC IPM; Cornell Cooperative Extension"
    },
    {
      "crop": "pepper-sweet",
      "pest": "bacterial-spot",
      "type": "disease",
      "severity": "high",
      "symptoms": "Small dark water-soaked spots on leaves and fruit, expanding to brown angular lesions with yellow halos. Fruit lesions become scabby. Defoliation in severe cases.",
      "organicManagement": [
        "Copper sprays every 7-10 days during humid weather; rotate with Bacillus subtilis to slow resistance.",
        "Remove infected leaves; sanitize tools."
      ],
      "prevention": "Buy certified disease-free transplants. Hot-water seed treatment (122F for 25 minutes) before planting. Three-year rotation. Drip irrigation, not overhead. Resistant varieties.",
      "regions": ["all"],
      "source": "UF/IFAS Extension; Cornell Cooperative Extension"
    },
    {
      "crop": "potato",
      "pest": "colorado-potato-beetle",
      "type": "pest",
      "severity": "severe",
      "symptoms": "Yellow-and-black-striped adult beetles (1/3 inch). Bright orange larvae (humpbacked, soft-bodied) feeding in clusters on leaves. Orange egg clusters on leaf undersides. Defoliation can be total within a week of egg hatch.",
      "organicManagement": [
        "Handpick adults, larvae, and crush egg clusters daily once spotted.",
        "Spinosad or Bt var. tenebrionis (Bt-t) on small larvae.",
        "Mulch heavily with straw; the rough surface impedes adult movement.",
        "Encourage tachinid flies (which parasitize adults) by planting umbellifer flowers nearby."
      ],
      "prevention": "Rotate potatoes at least 1/4 mile from prior year's field (small gardens cannot rotate this far, so cultural controls and resistant cultivars matter more). Trap crops of eggplant lure adults early in the season for handpicking.",
      "regions": ["all"],
      "source": "UC IPM; Cornell Cooperative Extension"
    },
    {
      "crop": "potato",
      "pest": "potato-late-blight",
      "type": "disease",
      "severity": "severe",
      "symptoms": "Same Phytophthora infestans as tomato late blight. Water-soaked irregular spots on leaves, white fuzzy sporulation on undersides in humid weather. Tubers develop firm brown patches that rot in storage.",
      "organicManagement": [
        "Copper as preventive before symptoms.",
        "Kill foliage 2 weeks before harvest if blight is in the field; tubers survive if cut off from foliar inoculum."
      ],
      "prevention": "Plant certified disease-free seed potatoes. Resistant varieties (Sarpo Mira, Defender). Destroy cull piles and volunteer plants. Wide spacing for airflow. Hill plants well so spores cannot reach tubers.",
      "regions": ["all"],
      "source": "Cornell Cooperative Extension; USDA-APHIS"
    },
    {
      "crop": "potato",
      "pest": "wireworm",
      "type": "pest",
      "severity": "moderate",
      "symptoms": "Yellow-brown wiry hard-bodied larvae (1/2 to 1.5 inches) tunneling into tubers. Adults are click beetles. Damage shows as narrow tunnels into stored or harvested tubers.",
      "organicManagement": [
        "Trap with chunks of carrot or potato buried 2-4 inches deep; check every 2-3 days and destroy gathered larvae."
      ],
      "prevention": "Avoid planting potatoes immediately after sod or pasture; wireworms are worst in beds that were grass in the prior 2-3 years. Beneficial nematodes (Steinernema carpocapsae) reduce populations.",
      "regions": ["all"],
      "source": "WSU Extension; UC IPM"
    },
    {
      "crop": "potato",
      "pest": "scab",
      "type": "disease",
      "severity": "moderate",
      "symptoms": "Rough corky raised or sunken patches on tuber skin. Tubers are still edible (peel deeper) but unmarketable. Caused by Streptomyces scabies in alkaline soil.",
      "organicManagement": [
        "Sulfur applied at planting acidifies soil locally."
      ],
      "prevention": "Keep soil pH below 5.5 for potato beds. Avoid manure (raises pH and feeds Streptomyces). Resistant varieties (Russet Burbank is susceptible; King Harry and Norland are resistant). Even soil moisture during tuber initiation.",
      "regions": ["all"],
      "source": "Cornell Cooperative Extension; UC IPM"
    },
    {
      "crop": "eggplant",
      "pest": "flea-beetle",
      "type": "pest",
      "severity": "high",
      "symptoms": "Tiny (1/16 inch) black or bronze beetles that jump like fleas. Numerous small round holes ('shotgun') in leaves. Seedlings can be killed outright; established plants tolerate moderate damage.",
      "organicManagement": [
        "Floating row cover from transplant until plants are 1 foot tall.",
        "Kaolin clay (Surround) coats leaves and deters feeding.",
        "Spinosad or pyrethrin on heavy populations."
      ],
      "prevention": "Trap crops of mustard or arugula draw flea beetles away. Two-year rotation. Delay planting until weather warms; cold transplants are the most vulnerable.",
      "regions": ["all"],
      "source": "Cornell Cooperative Extension; UC IPM"
    },
    {
      "crop": "cucumber",
      "pest": "cucumber-beetle-striped",
      "type": "pest",
      "severity": "severe",
      "symptoms": "Yellow beetle with three black stripes (1/4 inch). Feeds on cotyledons, flowers, and fruit. Vector of bacterial wilt (Erwinia tracheiphila) which kills the plant. Striped cucumber beetles transmit cucumber mosaic virus too.",
      "organicManagement": [
        "Floating row cover from emergence until flowering (remove for pollination).",
        "Kaolin clay coats foliage and deters feeding.",
        "Yellow sticky traps to monitor.",
        "Pyrethrin or spinosad on heavy populations."
      ],
      "prevention": "Two-year rotation. Trap crops of Hubbard or buttercup squash draw beetles away from main planting. Bacterial-wilt-resistant varieties (County Fair, Saladin). Mulch to deter overwintering adults emerging from soil.",
      "regions": ["all"],
      "source": "UC IPM; Cornell Cooperative Extension"
    },
    {
      "crop": "cucumber",
      "pest": "cucumber-beetle-spotted",
      "type": "pest",
      "severity": "high",
      "symptoms": "Yellow beetle with 12 black spots (1/4 inch). Same damage as striped cucumber beetle plus more frequent attacks on flowers and fruit. Larvae feed on roots.",
      "organicManagement": [
        "Same as striped cucumber beetle."
      ],
      "prevention": "Same as striped cucumber beetle.",
      "regions": ["all"],
      "source": "UC IPM; UF/IFAS Extension"
    },
    {
      "crop": "cucumber",
      "pest": "bacterial-wilt",
      "type": "disease",
      "severity": "severe",
      "symptoms": "Sudden wilting of one vine, then whole plant, with leaves still green initially. White milky strands form between cut stem ends when squeezed. Plant dies within 1-2 weeks. Vectored by cucumber beetles, no cure once infection is established.",
      "organicManagement": [
        "Remove and destroy wilting plants immediately to remove beetle bait."
      ],
      "prevention": "Control cucumber beetles aggressively from emergence. Plant resistant varieties (County Fair). Row cover until flowering.",
      "regions": ["northeast-us", "midwest-us", "northern-us"],
      "source": "Cornell Cooperative Extension"
    },
    {
      "crop": "cucumber",
      "pest": "powdery-mildew",
      "type": "disease",
      "severity": "high",
      "symptoms": "White powdery patches on leaf upper surfaces, spreading to cover whole leaves. Leaves yellow and dry. Premature harvest cutoff is the typical impact; severe defoliation kills the plant.",
      "organicManagement": [
        "Potassium bicarbonate or Bacillus subtilis spray at first signs.",
        "Whole milk diluted 1:9 in water, sprayed weekly on small infections.",
        "Remove infected leaves."
      ],
      "prevention": "Resistant varieties (Marketmore 76, Diva). Trellis for airflow. Avoid evening overhead watering. Wide spacing.",
      "regions": ["all"],
      "source": "Cornell Cooperative Extension; UC IPM"
    },
    {
      "crop": "cucumber",
      "pest": "downy-mildew",
      "type": "disease",
      "severity": "severe",
      "symptoms": "Yellow angular spots on leaf upper surfaces, bounded by leaf veins. Purple-gray fuzz on undersides in humid weather. Leaves brown and shrivel; vines lose photosynthetic area and stop producing.",
      "organicManagement": [
        "Copper-based fungicide as preventive when forecast issues a regional alert.",
        "Remove infected leaves; do not compost."
      ],
      "prevention": "Plant resistant varieties (DMR-NY 401, Bristol). Trellis for airflow. Time plantings to mature before mid-August in regions where the disease arrives on wind currents.",
      "regions": ["northeast-us", "southeast-us", "midwest-us"],
      "source": "Cornell Cooperative Extension; UF/IFAS Extension"
    },
    {
      "crop": "zucchini",
      "pest": "squash-vine-borer",
      "type": "pest",
      "severity": "severe",
      "symptoms": "Sudden wilting of one or all vines. Sawdust-like frass (excrement) at the base of the stem. Splitting the stem reveals a fat white grub (1 inch) tunneling inside. Adult is a clear-winged moth that looks like a wasp.",
      "organicManagement": [
        "Slit infested stems lengthwise, remove the borer, bury the stem to encourage adventitious roots.",
        "Inject Bt into the stem at the entry hole with a syringe.",
        "Wrap stems in foil from soil line to first leaf, blocking egg-laying."
      ],
      "prevention": "Second planting 4-6 weeks after the first carries through after the first is lost. Buttercup, butternut, and tromboncino squash resist borers (Cucurbita moschata species). Pheromone traps to monitor adult flights. Floating row cover from emergence until flowering.",
      "regions": ["northeast-us", "midwest-us", "southeast-us", "central-us"],
      "source": "Penn State Extension; Cornell Cooperative Extension"
    },
    {
      "crop": "zucchini",
      "pest": "squash-bug",
      "type": "pest",
      "severity": "high",
      "symptoms": "Brown-gray shield-shaped bugs (5/8 inch) clustered at the base of stems and on leaf undersides. Bronze-colored eggs in tight clusters between leaf veins. Wilting and yellowing leaves due to sap loss, then plant death.",
      "organicManagement": [
        "Handpick adults and crush egg clusters daily; bugs hide under boards laid on the soil overnight (lift and crush in the morning).",
        "Vacuum heavy populations with a hand vacuum.",
        "Insecticidal soap on young nymphs only (adults shrug it off)."
      ],
      "prevention": "Two-year rotation. Cleanup of debris and mulch in fall denies overwintering shelter. Trap crops of blue Hubbard squash.",
      "regions": ["all"],
      "source": "UC IPM; Cornell Cooperative Extension"
    },
    {
      "crop": "zucchini",
      "pest": "powdery-mildew",
      "type": "disease",
      "severity": "high",
      "symptoms": "White powdery patches on leaves and stems. Common late-summer cause of vine collapse on summer squash.",
      "organicManagement": [
        "Same as on cucumber: potassium bicarbonate, Bacillus subtilis, diluted milk spray, leaf removal."
      ],
      "prevention": "Resistant varieties (Dunja, Costata Romanesco). Wide spacing for airflow. Second planting timed to take over after the first declines.",
      "regions": ["all"],
      "source": "Cornell Cooperative Extension"
    },
    {
      "crop": "winter-squash",
      "pest": "squash-vine-borer",
      "type": "pest",
      "severity": "high",
      "symptoms": "Same as on zucchini. C. pepo varieties (acorn, delicata, spaghetti) are highly susceptible; C. moschata varieties (butternut, tromboncino) are resistant.",
      "organicManagement": [
        "Same as on zucchini."
      ],
      "prevention": "Plant C. moschata varieties (butternut, tromboncino) instead of C. pepo where vine borer is endemic.",
      "regions": ["northeast-us", "midwest-us", "southeast-us"],
      "source": "Penn State Extension"
    },
    {
      "crop": "watermelon",
      "pest": "anthracnose",
      "type": "disease",
      "severity": "high",
      "symptoms": "Brown sunken lesions on fruit with pinkish ooze in humid weather. Small dark spots on leaves expanding into brown patches. Vines girdle and collapse.",
      "organicManagement": [
        "Copper-based fungicide every 7-10 days during fruit development.",
        "Remove infected fruit and crop debris."
      ],
      "prevention": "Three-year rotation. Resistant varieties (Crimson Sweet, Charleston Gray). Drip irrigation. Mulch.",
      "regions": ["southeast-us", "southern-us", "midwest-us"],
      "source": "UF/IFAS Extension"
    },
    {
      "crop": "cabbage",
      "pest": "cabbage-worm",
      "type": "pest",
      "severity": "high",
      "symptoms": "Velvety green caterpillars (1.25 inches at maturity) with faint yellow stripes. Large ragged holes in leaves. Dark green pellets of frass accumulate in leaf bases. Adult is the white cabbage butterfly (Pieris rapae) you see fluttering through the garden in spring.",
      "organicManagement": [
        "Bt var. kurstaki on small larvae; reapply after rain.",
        "Spinosad on larger larvae.",
        "Handpick daily on small plantings.",
        "Floating row cover prevents adult egg-laying."
      ],
      "prevention": "Companion plant with dill, fennel, calendula to attract Trichogramma and braconid parasitoids. Two-year rotation away from brassicas. Yellow sticky traps to monitor adult flights.",
      "regions": ["all"],
      "source": "Cornell Cooperative Extension; UC IPM"
    },
    {
      "crop": "cabbage",
      "pest": "cabbage-looper",
      "type": "pest",
      "severity": "high",
      "symptoms": "Green caterpillar with two narrow white stripes along each side and a looping inchworm gait. Larger and faster-feeding than cabbage worm. Adult is a brown moth with a silver figure-8 marking on each wing.",
      "organicManagement": [
        "Same as cabbage worm: Bt-k, spinosad, row cover, handpicking."
      ],
      "prevention": "Same as cabbage worm.",
      "regions": ["all"],
      "source": "UC IPM"
    },
    {
      "crop": "cabbage",
      "pest": "diamondback-moth",
      "type": "pest",
      "severity": "high",
      "symptoms": "Small (1/3 inch) light green caterpillars that drop on silk threads when disturbed. Window-pane feeding (only one leaf surface eaten at first) progressing to large holes. Adult moth has a diamond pattern on folded wings.",
      "organicManagement": [
        "Bt-k early; diamondback moth has documented Bt resistance in some regions, so monitor efficacy.",
        "Spinosad as rotation partner with Bt to slow resistance."
      ],
      "prevention": "Row cover. Resistant varieties (Acephate-tolerant in commercial settings, glossy-leaf varieties in the garden). Avoid back-to-back brassica plantings.",
      "regions": ["all"],
      "source": "UF/IFAS Extension; Texas A&M AgriLife Extension"
    },
    {
      "crop": "cabbage",
      "pest": "cabbage-root-maggot",
      "type": "pest",
      "severity": "high",
      "symptoms": "Stunted yellowing plants. Wilting in midday heat. Pulled plants show white maggots (1/3 inch) and tunnels in the root system. Most severe on transplants and direct-seeded brassicas in cool wet springs.",
      "organicManagement": [
        "Beneficial nematodes (Steinernema feltiae) drenched at the root zone.",
        "No effective rescue once damage is visible."
      ],
      "prevention": "Floating row cover from transplanting through harvest, anchored at the soil line. Cardboard or felt collars (4 inches diameter) around each transplant block egg-laying. Two-year rotation.",
      "regions": ["northern-us", "northeast-us", "midwest-us", "pnw"],
      "source": "Cornell Cooperative Extension; WSU Extension"
    },
    {
      "crop": "cabbage",
      "pest": "clubroot",
      "type": "disease",
      "severity": "severe",
      "symptoms": "Stunted, wilting plants. Pulled plants show grossly swollen, distorted, clubbed roots. Soil-borne pathogen (Plasmodiophora brassicae) that persists 7-20 years once established.",
      "organicManagement": [
        "No organic cure; remove and destroy infected plants and as much surrounding soil as practical."
      ],
      "prevention": "Raise soil pH above 7.2 (alkaline conditions suppress P. brassicae). Liming the bed 3 months before planting. Avoid moving soil from infected beds. Resistant varieties (Kilaton, Tekila). Long rotations (7+ years) away from all brassicas including mustards and arugula.",
      "regions": ["all"],
      "source": "Cornell Cooperative Extension; Penn State Extension"
    },
    {
      "crop": "cabbage",
      "pest": "black-rot",
      "type": "disease",
      "severity": "high",
