  "entries": [
    {
      "crop": "pole-bean",
      "companion": "sweet-corn",
      "type": "beneficial",
      "mechanism": "nitrogen_fixing",
      "description": "Beans fix atmospheric nitrogen via Rhizobium root-nodule symbiosis; nitrogen released to companion corn over the season enriches the soil heavy-feeding corn depletes. The defining N-cycle pairing of the Three Sisters.",
      "strength": "strong",
      "source": "USDA-ARS Three Sisters research; Iroquois agricultural tradition"
    },
    {
      "crop": "sweet-corn",
      "companion": "pole-bean",
      "type": "beneficial",
      "mechanism": "structural_support",
      "description": "Corn stalks serve as a living trellis for climbing bean vines, eliminating the need for separate trellising. Plant beans after corn reaches ~6 inches so vines don't outpace the support.",
      "strength": "strong",
      "source": "USDA-ARS Three Sisters research; Iroquois agricultural tradition"
    },
    {
      "crop": "winter-squash",
      "companion": "sweet-corn",
      "type": "beneficial",
      "mechanism": "ground_cover",
      "description": "Sprawling squash vines and large leaves shade the soil at the base of the corn, retain moisture, and suppress weeds. The third sister's job is the ground layer.",
      "strength": "strong",
      "source": "USDA-ARS Three Sisters research; Iroquois agricultural tradition"
    },
    {
      "crop": "winter-squash",
      "companion": "pole-bean",
      "type": "beneficial",
      "mechanism": "ground_cover",
      "description": "Squash leaves shade the base of bean plants and conserve moisture; spiny varieties (Hubbard, Buttercup) also help deter raccoons and other corn-bed raiders.",
      "strength": "strong",
      "source": "USDA-ARS Three Sisters research; Iroquois agricultural tradition"
    },
    {
      "crop": "sweet-corn",
      "companion": "winter-squash",
      "type": "beneficial",
      "mechanism": "shade_provider",
      "description": "Tall corn provides afternoon shade to young squash vines, reducing transplant shock and heat stress in high-sun regions; especially valuable in arid and continental climates.",
      "strength": "moderate",
      "source": "USDA-ARS Three Sisters research; Iroquois agricultural tradition"
    },
    {
      "crop": "pole-bean",
      "companion": "winter-squash",
      "type": "beneficial",
      "mechanism": "nitrogen_fixing",
      "description": "Nitrogen released by bean root-nodule activity supplements squash needs as developing fruit ripens.",
      "strength": "strong",
      "source": "USDA-ARS Three Sisters research; Iroquois agricultural tradition"
    },
    {
      "crop": "basil",
      "companion": "tomato",
      "type": "beneficial",
      "mechanism": "pest_repellent",
      "description": "Basil's aromatic volatile oils repel aphids, whiteflies, and tomato hornworm moths searching for egg-laying sites. The widely-claimed flavor-enhancement effect lacks formal study but is reported across traditional sources.",
      "strength": "moderate",
      "source": "Cornell Cooperative Extension; Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "tomato",
      "companion": "basil",
      "type": "beneficial",
      "mechanism": "shade_provider",
      "description": "Tomato canopy provides afternoon shade that protects basil from leaf scorch and bolting in hot summer climates; useful pairing in mediterranean and arid beds.",
      "strength": "moderate",
      "source": "UC ANR Master Gardener publications"
    },
    {
      "crop": "marigold",
      "companion": "tomato",
      "type": "beneficial",
      "mechanism": "pest_repellent",
      "description": "French marigolds (Tagetes patula) produce alpha-terthienyl and other thiophene compounds in their roots that suppress root-knot nematodes (Meloidogyne spp.). The strongest empirically-supported companion-planting effect known. Plant 12-18 inches from tomato roots.",
      "strength": "strong",
      "source": "UC ANR; USDA-ARS nematology research"
    },
    {
      "crop": "marigold-signet",
      "companion": "tomato",
      "type": "beneficial",
      "mechanism": "pest_repellent",
      "description": "Signet marigolds (Tagetes tenuifolia) repel whitefly and aphids and provide some nematode suppression, though less than French marigolds. Edible flowers double as garnish.",
      "strength": "moderate",
      "source": "UC ANR Master Gardener publications"
    },
    {
      "crop": "nasturtium",
      "companion": "tomato",
      "type": "beneficial",
      "mechanism": "trap_crop",
      "description": "Nasturtium attracts aphids and whiteflies away from tomato plants as a sacrificial host. Spray nasturtium with insecticidal soap to kill the aphid colony before it spreads back to the tomatoes.",
      "strength": "moderate",
      "source": "Cornell Cooperative Extension; Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "borage",
      "companion": "tomato",
      "type": "beneficial",
      "mechanism": "pollinator_attractor",
      "description": "Borage flowers attract bumblebees and honey bees that improve tomato fruit set through buzz pollination. Reputed to deter tomato hornworm; folklore claims flavor improvement.",
      "strength": "moderate",
      "source": "Cornell Cooperative Extension; Cunningham, Great Garden Companions"
    },
    {
      "crop": "carrot",
      "companion": "tomato",
      "type": "beneficial",
      "mechanism": "space_efficiency",
      "description": "Carrots fit under sprawling tomato canopy; different root depth (carrots deep, tomato mid-deep) minimizes competition. The pairing is the title of Riotte's classic gardening canon.",
      "strength": "moderate",
      "source": "Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "tomato",
      "companion": "carrot",
      "type": "beneficial",
      "mechanism": "shade_provider",
      "description": "Tomato canopy shades carrot tops during late summer heat, slowing bolting and reducing greening on exposed shoulders of carrot roots.",
      "strength": "moderate",
      "source": "Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "parsley-flat",
      "companion": "tomato",
      "type": "beneficial",
      "mechanism": "pollinator_attractor",
      "description": "Parsley flowers (in its second biennial year) attract parasitic wasps and hoverflies that prey on tomato hornworm and aphids.",
      "strength": "moderate",
      "source": "Cornell Cooperative Extension; Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "asparagus",
      "companion": "tomato",
      "type": "beneficial",
      "mechanism": "pest_repellent",
      "description": "Asparagus produces compounds (asparagine derivatives) that deter root-knot nematodes around tomato roots. The reciprocal: tomato deters asparagus beetle. Long-standing mutual pairing in extension literature.",
      "strength": "moderate",
      "source": "Cornell Cooperative Extension; Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "tomato",
      "companion": "asparagus",
      "type": "beneficial",
      "mechanism": "pest_repellent",
      "description": "Tomato leaves contain solanine that deters asparagus beetle; planting tomatoes adjacent to permanent asparagus beds protects spear development from feeding damage.",
      "strength": "moderate",
      "source": "Cornell Cooperative Extension; Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "dill",
      "companion": "cabbage",
      "type": "beneficial",
      "mechanism": "pollinator_attractor",
      "description": "Dill flowers (umbels) attract parasitic wasps (Trichogramma, Cotesia) and hoverflies that prey on cabbage worm and cabbage looper larvae. Let some dill bolt for sustained flowering.",
      "strength": "moderate",
      "source": "Cornell Cooperative Extension; Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "dill",
      "companion": "broccoli",
      "type": "beneficial",
      "mechanism": "pollinator_attractor",
      "description": "Same mechanism as with cabbage — dill's umbel flowers draw beneficial parasitoid wasps and hoverflies, controlling cabbage moth larvae on broccoli.",
      "strength": "moderate",
      "source": "Cornell Cooperative Extension; Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "dill",
      "companion": "cauliflower",
      "type": "beneficial",
      "mechanism": "pollinator_attractor",
      "description": "Dill flowers draw parasitoid wasps that target cabbage moth caterpillars and aphids on cauliflower curds.",
      "strength": "moderate",
      "source": "Cornell Cooperative Extension; Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "dill",
      "companion": "brussels-sprouts",
      "type": "beneficial",
      "mechanism": "pollinator_attractor",
      "description": "Long-season brussels sprouts benefit from sustained beneficial-insect populations supported by bolted dill flowers through summer.",
      "strength": "moderate",
      "source": "Cornell Cooperative Extension; Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "dill",
      "companion": "kale",
      "type": "beneficial",
      "mechanism": "pollinator_attractor",
      "description": "Bolted dill flowers attract hoverflies and parasitic wasps that control aphid colonies on kale.",
      "strength": "moderate",
      "source": "Cornell Cooperative Extension; Riotte, Carrots Love Tomatoes"
    },
    {
      "crop": "thyme",
